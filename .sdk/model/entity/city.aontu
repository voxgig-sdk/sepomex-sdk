# Entity: city

main: kit: entity: city: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the city"
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "City name"
      t: "`$STRING`"
    }
    state_id: {
      h: "State Id"
      n: "state_id"
      r: false
      sh: "ID of the state this city belongs to"
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "city"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /cities"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 15
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/cities"
          q: {
            exist: [
              "page"
              "per_page"
            ]
          }
          s: [
            {
              lit: "cities"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /cities/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/cities/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "cities"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.city`"
          }
        }
      ]
    }
  }



}
