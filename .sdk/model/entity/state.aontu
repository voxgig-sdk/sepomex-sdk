# Entity: state

main: kit: entity: state: {

  alias: field: {}

  fields: {
    cities_count: {
      h: "Cities Count"
      n: "cities_count"
      r: false
      sh: "Number of cities in the state"
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the state"
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "State name"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "state"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /states"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 15
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/states"
          q: {
            exist: [
              "page"
              "per_page"
            ]
          }
          s: [
            {
              lit: "states"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /states/{id}/municipalities"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/states/{id}/municipalities"
          q: {
            "$action": "municipality"
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "states"
            }
            {
              var: "id"
            }
            {
              lit: "municipalities"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.municipalities`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /states/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/states/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "states"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.state`"
          }
        }
      ]
    }
  }



}
