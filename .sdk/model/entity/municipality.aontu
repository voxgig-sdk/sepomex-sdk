# Entity: municipality

main: kit: entity: municipality: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the municipality"
      t: "`$INTEGER`"
    }
    municipality_key: {
      h: "Municipality Key"
      n: "municipality_key"
      r: false
      sh: "Municipality key code"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Municipality name"
      t: "`$STRING`"
    }
    state_id: {
      h: "State Id"
      n: "state_id"
      r: false
      sh: "ID of the state this municipality belongs to"
      t: "`$INTEGER`"
    }
    zip_code: {
      h: "Zip Code"
      n: "zip_code"
      r: false
      sh: "Representative zip code for the municipality"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "municipality"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /municipalities"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 15
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/municipalities"
          q: {
            exist: [
              "page"
              "per_page"
            ]
          }
          s: [
            {
              lit: "municipalities"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /municipalities/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/municipalities/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "municipalities"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.municipality`"
          }
        }
      ]
    }
  }



}
