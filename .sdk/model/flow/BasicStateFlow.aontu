# BasicStateFlow

main: kit: flow: BasicStateFlow:
{
  entity: "state",
  kind: "basic",
  name: "BasicStateFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "state_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "state_ref01",
        srcdatavar: "state_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "state01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-state_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicStateFlow"
}